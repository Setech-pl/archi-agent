{
  "name": "archground",
  "displayName": "ArchGround",
  "version": "0.1.0-private.0",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "setech-pl",
  "type": "module",
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "build:demo": "node scripts/prepare-demo-output.mjs clean && tsc -p tsconfig.demo.json && node scripts/prepare-demo-output.mjs finalize",
    "demo": "npm run build:demo && node dist/demo/space-mission-demo.js",
    "demo:dry-run": "npm run build:demo && node dist/demo/space-mission-demo.js --dry-run",
    "local:models": "npm run build:demo && node dist/demo/lm-studio-demo.js models",
    "demo:llm:dry-run": "npm run build:demo && node dist/demo/lm-studio-demo.js generate --dry-run",
    "demo:llm": "npm run build:demo && node dist/demo/lm-studio-demo.js generate",
    "extension:typecheck": "tsc -p vscode-extension/tsconfig.json",
    "extension:build": "node vscode-extension/scripts/build.mjs",
    "extension:package": "node vscode-extension/scripts/package-vsix.mjs",
    "extension:verify": "node vscode-extension/scripts/verify-vsix.mjs",
    "extension:test": "vitest run test/runtime test/vscode-extension"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
