{
  "name": "archi-agent",
  "displayName": "Archi Agent",
  "description": "Grounded architecture diagram generation with local or cloud models: validated PlantUML sequence and component diagrams from flow descriptions and an Architecture Knowledge Pack.",
  "version": "0.3.0-alpha.4",
  "publisher": "setech-pl",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "architecture",
    "plantuml",
    "sequence diagram",
    "lm studio",
    "local model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:archiAgent.saveDiagramAndReport",
    "onCommand:archiAgent.buildKnowledgePack",
    "onCommand:archiAgent.open",
    "onCommand:archiAgent.convertToMarkdown",
    "onCommand:archiAgent.configureKnowledgePack",
    "onCommand:archiAgent.generateDiagram",
    "onCommand:archiAgent.generateSequenceDiagram",
    "onCommand:archiAgent.selectProviderProfile",
    "onCommand:archiAgent.selectModel",
    "onCommand:archiAgent.checkProviderConfiguration",
    "onCommand:archiAgent.setApiKey",
    "onCommand:archiAgent.deleteApiKey",
    "onCommand:archiAgent.selectLocalProviderProfile",
    "onCommand:archiAgent.selectLocalModel",
    "onCommand:archiAgent.configuration",
    "onCommand:archiAgent.help",
    "onCommand:archiAgent.knowledgeBrowser",
    "onCommand:archiAgent.buildKnowledgePackFromActiveFile",
    "onCommand:archiAgent.refreshKnowledge",
    "onCommand:archiAgent.openKnowledgeRecord",
    "onView:archiAgent.knowledge"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the Knowledge Pack path and local model settings are read from user settings only.",
      "restrictedConfigurations": [
        "archiAgent.knowledgePackPath",
        "archiAgent.localModel.baseUrl",
        "archiAgent.localModel.model",
        "archiAgent.localModel.profile",
        "archiAgent.localModel.selectedModel",
        "archiAgent.localModel.selectedModelProfile",
        "archiAgent.localModel.timeoutSeconds"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The Knowledge Pack and flow files are read from the local file system."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "archiAgent.saveDiagramAndReport",
        "title": "Save Diagram and Report",
        "category": "Archi"
      },
      {
        "command": "archiAgent.buildKnowledgePack",
        "title": "Build Knowledge Pack from Documents",
        "category": "Archi"
      },
      {
        "command": "archiAgent.open",
        "title": "Open",
        "category": "Archi"
      },
      {
        "command": "archiAgent.convertToMarkdown",
        "title": "Convert to Markdown",
        "category": "Archi"
      },
      {
        "command": "archiAgent.configureKnowledgePack",
        "title": "Configure Knowledge Pack",
        "category": "Archi"
      },
      {
        "command": "archiAgent.generateDiagram",
        "title": "Create Diagram",
        "category": "Archi"
      },
      {
        "command": "archiAgent.generateSequenceDiagram",
        "title": "Generate Sequence Diagram",
        "category": "Archi"
      },
      {
        "command": "archiAgent.selectProviderProfile",
        "title": "Select Provider Profile",
        "category": "Archi"
      },
      {
        "command": "archiAgent.selectModel",
        "title": "Select Model",
        "category": "Archi"
      },
      {
        "command": "archiAgent.checkProviderConfiguration",
        "title": "Check Provider Configuration",
        "category": "Archi"
      },
      {
        "command": "archiAgent.setApiKey",
        "title": "Set or Update API Key",
        "category": "Archi"
      },
      {
        "command": "archiAgent.deleteApiKey",
        "title": "Delete Saved API Key",
        "category": "Archi"
      },
      {
        "command": "archiAgent.configuration",
        "title": "Configuration",
        "category": "Archi"
      },
      {
        "command": "archiAgent.help",
        "title": "Help",
        "category": "Archi"
      },
      {
        "command": "archiAgent.knowledgeBrowser",
        "title": "Knowledge Browser",
        "category": "Archi"
      },
      {
        "command": "archiAgent.buildKnowledgePackFromActiveFile",
        "title": "Build Knowledge Pack from Active File",
        "category": "Archi"
      },
      {
        "command": "archiAgent.refreshKnowledge",
        "title": "Refresh Knowledge",
        "category": "Archi"
      },
      {
        "command": "archiAgent.openKnowledgeRecord",
        "title": "Open Knowledge Record",
        "category": "Archi"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "archiAgent.selectProviderProfile",
          "when": "false"
        },
        {
          "command": "archiAgent.selectModel",
          "when": "false"
        },
        {
          "command": "archiAgent.setApiKey",
          "when": "false"
        },
        {
          "command": "archiAgent.deleteApiKey",
          "when": "false"
        },
        {
          "command": "archiAgent.generateSequenceDiagram",
          "when": "false"
        },
        {
          "command": "archiAgent.configureKnowledgePack",
          "when": "false"
        },
        {
          "command": "archiAgent.checkProviderConfiguration",
          "when": "false"
        },
        {
          "command": "archiAgent.refreshKnowledge",
          "when": "false"
        },
        {
          "command": "archiAgent.openKnowledgeRecord",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "archiAgent.buildKnowledgePackFromActiveFile",
          "group": "archi",
          "when": "resourceScheme == file || resourceScheme == untitled"
        }
      ],
      "view/title": [
        {
          "command": "archiAgent.refreshKnowledge",
          "when": "view == archiAgent.knowledge",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Archi Agent",
      "properties": {
        "archiAgent.knowledgePackPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Absolute path of the Architecture Knowledge Pack directory (the folder holding `systems.md`, `actors.md`, `relationships.md`, `aliases.md` and `rules.md`). The directory may be anywhere on the local file system; it is never resolved relative to a workspace or the working directory."
        },
        "archiAgent.localModel.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:1234/v1",
          "markdownDescription": "Base URL of the local OpenAI-compatible server (for example LM Studio). Only literal loopback URLs are accepted: `http://127.0.0.1:<port>/v1` or `http://[::1]:<port>/v1`."
        },
        "archiAgent.localModel.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Legacy LM Studio model identifier. Existing effective user, workspace and workspace-folder values remain compatible until a provider profile is explicitly selected. New model selections are stored in `archiAgent.localModel.selectedModel`."
        },
        "archiAgent.localModel.profile": {
          "type": "string",
          "enum": [
            "local-lm-studio",
            "local-ollama",
            "cloud-anthropic",
            "cloud-openai",
            "cloud-openrouter"
          ],
          "enumItemLabels": [
            "LM Studio",
            "Ollama",
            "Anthropic",
            "OpenAI",
            "OpenRouter"
          ],
          "default": "local-lm-studio",
          "scope": "machine",
          "markdownDescription": "Provider profile used on this computer. Cloud API keys are stored separately in VS Code SecretStorage. This machine-scoped choice is not synchronized by Settings Sync and cannot be overridden by a workspace. Use **Archi: Configuration \u2192 LLM Provider** to change it."
        },
        "archiAgent.localModel.selectedModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Model selected for the explicit provider profile on this computer. This machine-scoped choice is not synchronized by Settings Sync and cannot be overridden by a workspace."
        },
        "archiAgent.localModel.selectedModelProfile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Internal binding between the selected model and its provider profile. Archi Agent manages this machine-scoped setting automatically; do not edit it manually."
        },
        "archiAgent.localModel.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 600,
          "markdownDescription": "Time limit in seconds for one model request."
        },
        "archiAgent.defaultAuthor": {
          "type": "string",
          "default": "Archi Agent",
          "markdownDescription": "Author written into the front matter when a flow is entered as a plain description instead of a flow document."
        },
        "archiAgent.diagnostics.verbose": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Write safe structured Archi Agent pipeline diagnostics to the Archi Agent output channel."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "archiAgent.knowledge",
          "name": "Archi Agent \u2014 Knowledge"
        }
      ]
    }
  }
}
