{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Archi Agent extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "archi-agent: build extension"
    }
  ]
}
